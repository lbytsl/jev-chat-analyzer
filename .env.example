# ============================================================
# 复制本文件为 .env 并填入你自己的密钥后使用。
# 真实 .env 已被 .gitignore 忽略，不会上传；本文件只是模板，不含任何密钥。
# ============================================================

# ---------- 分类层：Jev（负责意图/情绪判定） ----------
# 两种接入方式，区别只在 BASE_URL 的写法：
#   1) TypeSafe 原生网关：BASE_URL 只写主机名，代码会补上原生路径 /v1/systemone
#        TYPESAFE_BASE_URL=https://api.typesafe.ai
#   2) OpenRouter alpha decisions：BASE_URL 写完整端点，代码原样使用（不加任何路径）
#        TYPESAFE_BASE_URL=https://openrouter.ai/api/alpha/decisions
#        TYPESAFE_API_KEY=sk-or-...        # 这里要填 OpenRouter 的 key
# 模型名：原生网关写版本化 ID jev-1.13.0，OpenRouter 写 typesafe/jev-1.13。
# 这里刻意不写别名 jev-latest：别名会随新版本发布而移动，同一批输入可能在你
# 没有任何改动的情况下换答案。官方建议是——调好置信度阈值后钉住版本化 ID。
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=jev-1.13.0

# ---------- 生成层：DeepSeek（负责「潜台词」+ 三条回复建议） ----------
# 这一层是 OpenAI 兼容的 /chat/completions 调用，可以换成任意 OpenAI 兼容端点：
#   OpenAI / 通义千问 / 智谱 GLM / Kimi(Moonshot) / 阶跃 StepFun / 本地 Ollama·vLLM 等。
# 只需改下面三个变量：BASE_URL 指到对应厂商地址、MODEL 写对应模型名、API_KEY 填对应密钥。
# BASE_URL 填到 /v1 那一层就行（如 https://api.stepfun.com/v1），代码会补 /chat/completions；
# 直接粘完整的 .../v1/chat/completions 端点也认，不会拼成 /chat/completions/chat/completions。
# 前提：该端点需支持 JSON 输出模式（response_format: json_object），否则生成层会解析失败。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---------- 生成层的多套配置（一般不用手改，界面「配置 → 生成层」自动维护） ----------
# 生成层可以保存多套「地址 + 模型 + 密钥」并切换启用哪套：整张表存在下面这行单行 JSON 里，
# 当前启用的那套的名字记在 LLM_ACTIVE。两个键都没写时，上面的 DEEPSEEK_* 就是唯一那套。
# 写过之后 DEEPSEEK_* 不再参与判定；LLM_PROFILES 手改坏了会退回 DEEPSEEK_*，界面会提示。
#LLM_PROFILES=[{"name": "DeepSeek 官方", "base_url": "https://api.deepseek.com", "model": "deepseek-chat", "api_key": "sk-..."}]
#LLM_ACTIVE=DeepSeek 官方

# ---------- 输出设置（也能在界面「配置 → 输出设置」里改） ----------
# 点「生成推荐回复」时给几个方向：1–6。这个值会写进提示词，也会用于截断模型多给的建议。
GEN_SUGGESTIONS_COUNT=3

# ---------- 可选：并发度（一般不用动） ----------
GEN_MAX_WORKERS=6
JEV_MAX_WORKERS=4
