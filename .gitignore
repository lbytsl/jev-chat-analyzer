# ===== 密钥（绝对不能上传） =====
# 真实 .env 就在仓库根目录（服务只读它），开源版请只提交 .env.example。
.env
.env.*
*.env
!.env.example

# ===== WorkBuddy 内部目录（含工作日志 / 项目记忆 / 作者私人信息） =====
.workbuddy/

# ===== 本地改动备份与缓存（中间态，非源码） =====
_backup/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.log

# ===== 虚拟环境（依赖清单见 pyproject.toml，用 uv sync 同步） =====
.venv/

# ===== 前端（源码在 frontend/src，依赖与产物不入库） =====
frontend/node_modules/
frontend/dist/

# ===== macOS 资源叉垃圾文件（每个真实文件旁自动生成的 ._xxx） =====
._*
.DS_Store
.Spotlight-V100
.Trashes

# ===== 运行产物（回流池与回归结果会自动重建，且可能攒入真实对话样本） =====
var/
low_confidence_pool.json

# ===== Playwright CLI 录制产物（自动化临时文件，非源码） =====
.playwright-cli/

实现说明.md
标签提案-恋爱补充.md
.idea/.gitignore
.idea/jev-chat-analyzer.iml
.idea/misc.xml
.idea/modules.xml
.idea/vcs.xml
.idea/inspectionProfiles/profiles_settings.xml
.idea/inspectionProfiles/Project_Default.xml
